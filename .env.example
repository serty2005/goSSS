# ===============================================================
#                Конфигурация Etalon Server
# ===============================================================

# --- Общие настройки сервера ---
# Порт, на котором будет работать HTTP-сервер
PORT=8080
# Адрес для подключения к базе данных PostgreSQL
DATABASE_URL="postgres://etalon:1@postgres:5432/etalon_db?sslmode=disable"
# Директория для хранения лог-файлов
LOG_DIR="./logs"
#LOG_LEVEL=debug
# Отключить запись логов в файлы (оставить только вывод в консоль). true/false
DISABLE_FILE_LOGGING=false
# Общий таймаут для внешних HTTP-запросов (в секундах)
REQUEST_TIMEOUT_SEC=15
# Список разрешенных источников (CORS), через запятую
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- Настройки API ---
# Секретный ключ для аутентификации агентов (Bearer token)
AGENT_API_KEY="fdsjkjl22"
# Секретный ключ для запуска ручных операций через API (например, seeder)
SEEDER_KEY="super-secret-key-for-seeding"

JWT_SECRET="112"
JWT_EXPIRATION_MIN=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=112

# --- Настройки клиента ServiceDesk ---
# Базовый URL для API ServiceDesk
BASE_URL="https://myhoreca.itsm365.com/sd/services/rest"
# Ключ доступа к API ServiceDesk
SDKEY="xx-xx-x"
# Максимальное количество запросов в секунду к API ServiceDesk
RATE_LIMIT=20
# Количество повторных попыток при ошибках сети или сервера ServiceDesk
MAX_RETRIES=1
# Количество одновременных запросов к API ServiceDesk для получения деталей сущностей
CONCURRENT_REQUESTS=10
# Редактирование и создание только логирует запрос к API ServiceDesk
SD_DRY_RUN=false


# ===============================================================
#          Настройки фоновых шлюзов (Gateways)
# ===============================================================
# Здесь можно включать/отключать и настраивать каждый фоновый
# процесс независимо.

# --- Шлюз синхронизации с ServiceDesk (основные сущности) ---
ENABLE_SDESK_GATEWAY=true
# Интервал синхронизации (в минутах)
SDESK_SYNC_INTERVAL_MIN=3

# --- Шлюз синхронизации контрактов ---
ENABLE_CONTRACT_GATEWAY=true
# Интервал синхронизации (в минутах)
CONTRACT_SYNC_INTERVAL_MIN=6

# --- Шлюз опроса статусов серверов (RMS Polling) ---
ENABLE_POLLING_GATEWAY=true
# Интервал, реже которого серверы не будут опрашиваться (в часах)
SERVER_POLLING_INTERVAL_HOURS=12
# Максимальное количество серверов, опрашиваемых за один цикл
SERVER_POLLING_BATCH_SIZE=20
# Данные для доступа к RMS (если требуются) - оставьте пустыми, если не используются
RMS_LOGIN=""
RMS_PASSWORD_1=""
RMS_PASSWORD_2=""

# --- Шлюз для данных от агентов (FTP) ---
ENABLE_AGENT_FTP_GATEWAY=true
# Интервал проверки FTP-сервера на наличие новых файлов (в минутах)
AGENT_FTP_INTERVAL_MIN=2
# Адрес FTP-сервера
FTP_HOST="ftp.xxx.io"
# Порт FTP-сервера
FTP_PORT="21"
# Пользователь для доступа к FTP
FTP_USER="ftpuser"
# Пароль для доступа к FTP
FTP_PASSWORD="xxx"
# Путь к директории с файлами на FTP-сервере
FTP_PATH="/"
# Путь к локальной директории для кэширования файлов с FTP
FTP_CACHE_PATH="./ftp_cache"

# --- Шлюз поиска дубликатов ---
ENABLE_DUPLICATES_GATEWAY=true
# Интервал запуска поиска дубликатов (в часах)
DUPLICATES_SEARCH_INTERVAL_HOURS=1