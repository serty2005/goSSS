# App
PORT=8080
DATABASE_URL=postgres://postgres:postgres@10.25.1.113:5432/postgres?sslmode=disable
LOG_DIR=./logs
LOG_LEVEL=info
DISABLE_FILE_LOGGING=false
REQUEST_TIMEOUT_SEC=15
ALLOWED_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me
JWT_EXPIRATION_MIN=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_FULLNAME=Admin

# Agent adapter releases / S3 catalog
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_CONSOLE_PORT=9001
AGENTS_PROXY_PORT=8081

AGENT_ADAPTER_S3_ENABLED=false
AGENT_ADAPTER_S3_ENDPOINT=http://minio:9000
AGENT_ADAPTER_S3_REGION=us-east-1
AGENT_ADAPTER_S3_BUCKET=agents
AGENT_ADAPTER_S3_ACCESS_KEY=minioadmin
AGENT_ADAPTER_S3_SECRET_KEY=minioadmin
AGENT_ADAPTER_PUBLIC_BASE_URL=http://localhost:8081/agents
AGENT_ADAPTER_CATALOG_KEY=catalog/index.json
AGENT_ADAPTER_SYNC_INTERVAL_MIN=5
AGENT_ADAPTER_DEFAULT_CHANNEL=stable

# API keys
AGENT_API_KEY=
BRAND_NAME=MyHoreca_Xenion
SEEDER_KEY=super-secret-key-for-seeding

# ServiceDesk
BASE_URL=https://servicedesk.example.com
SDKEY=
RATE_LIMIT=45
MAX_RETRIES=3
CONCURRENT_REQUESTS=10
SD_DRY_RUN=true

# Gateways/Workers
ENABLE_SDESK_GATEWAY=false
SDESK_SYNC_INTERVAL_MIN=10
TICKET_STORAGE_PATH=./storage/tickets

ENABLE_CONTRACT_GATEWAY=false
CONTRACT_SYNC_INTERVAL_MIN=30
COMMON_CONTRACT_ID=common-contract

ENABLE_POLLING_GATEWAY=false
SERVER_POLLING_INTERVAL_HOURS=12
SERVER_POLLING_BATCH_SIZE=50
RMS_LOGIN=
RMS_PASSWORD_1=
RMS_PASSWORD_2=

ENABLE_AGENT_FTP_GATEWAY=false
AGENT_FTP_INTERVAL_MIN=60
FTP_HOST=localhost
FTP_USER=user
FTP_PASSWORD=password
FTP_PORT=21
FTP_PATH=/
FTP_CACHE_PATH=./ftp_cache

ENABLE_DUPLICATES_GATEWAY=false
DUPLICATES_SEARCH_INTERVAL_HOURS=24

ENABLE_FR_DISCREPANCY_FINDER=false
FR_DISCREPANCY_CHECK_INTERVAL_HOURS=6

ENABLE_STATUS_WORKER=false
STATUS_WORKER_INTERVAL_MIN=2

# Bitrix24 (incoming webhook)
ENABLE_BITRIX_GATEWAY=false
BITRIX_BASE_URL=
BITRIX_ORIGINATOR_ID=ETALON_SD
BITRIX_CATEGORY_ID=17
BITRIX_SERVICE_POINT_IBLOCK_ID=101
BITRIX_SYNC_INTERVAL_MIN=5
BITRIX_DICTIONARY_SYNC_INTERVAL_HOURS=24
ETALON_TICKET_BASE_URL=http://localhost
