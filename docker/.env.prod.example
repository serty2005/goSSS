# Docker Hub images
BACKEND_IMAGE=serty2005/gosss-backend:latest
FRONTEND_IMAGE=serty2005/gosss-frontend:latest

# Published ports
SERVER_PORT=9999
FRONTEND_PORT=80

# Absolute path on host with seeder mock-data JSON files
SEEDER_MOCK_DATA_PATH=/opt/gosss/mock_data

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# App
PORT=8080
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres?sslmode=disable
LOG_DIR=./logs
LOG_LEVEL=info
DISABLE_FILE_LOGGING=false
REQUEST_TIMEOUT_SEC=15
ALLOWED_ORIGINS=http://localhost

# Auth
JWT_SECRET=change-me
JWT_EXPIRATION_MIN=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_FULLNAME=Admin

# Agent adapter releases / S3 catalog
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z-cpuv1
MINIO_ROOT_USER=gosss-minio
MINIO_ROOT_PASSWORD=change-me
MINIO_CONSOLE_DOMAIN=minio.sd.example.com
MINIO_BROWSER_REDIRECT_URL=https://minio.sd.example.com/

AGENT_ADAPTER_S3_ENABLED=true
AGENT_ADAPTER_S3_ENDPOINT=http://minio:9000
AGENT_ADAPTER_S3_REGION=us-east-1
AGENT_ADAPTER_S3_BUCKET=agents
AGENT_ADAPTER_S3_ACCESS_KEY=gosss-minio
AGENT_ADAPTER_S3_SECRET_KEY=change-me
AGENT_ADAPTER_PUBLIC_BASE_URL=https://sd.example.com/agents
AGENT_ADAPTER_CATALOG_KEY=catalog/index.json
AGENT_ADAPTER_SYNC_INTERVAL_MIN=5
AGENT_ADAPTER_DEFAULT_CHANNEL=stable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# API keys
AGENT_API_KEY=
ARTICLE_WEBHOOK_KEY=
SEEDER_KEY=change-me

# ServiceDesk
BASE_URL=https://servicedesk.example.com
SDKEY=
RATE_LIMIT=45
MAX_RETRIES=3
CONCURRENT_REQUESTS=10
SD_DRY_RUN=false

# Gateways/Workers
ENABLE_SDESK_GATEWAY=false
SDESK_SYNC_INTERVAL_MIN=10
TICKET_STORAGE_PATH=./storage/tickets

ENABLE_CONTRACT_GATEWAY=false
CONTRACT_SYNC_INTERVAL_MIN=720
COMMON_CONTRACT_ID=common-contract

ENABLE_POLLING_GATEWAY=false
SERVER_POLLING_INTERVAL_HOURS=12
SERVER_POLLING_BATCH_SIZE=50
RMS_LOGIN=
RMS_PASSWORD_1=
RMS_PASSWORD_2=

ENABLE_AGENT_FTP_GATEWAY=false
AGENT_FTP_INTERVAL_MIN=60
FTP_HOST=localhost
FTP_USER=user
FTP_PASSWORD=password
FTP_PORT=21
FTP_PATH=/
FTP_CACHE_PATH=./ftp_cache

ENABLE_DUPLICATES_GATEWAY=false
DUPLICATES_SEARCH_INTERVAL_HOURS=24

ENABLE_FR_DISCREPANCY_FINDER=false
FR_DISCREPANCY_CHECK_INTERVAL_HOURS=6

ENABLE_STATUS_WORKER=false
STATUS_WORKER_INTERVAL_MIN=2
